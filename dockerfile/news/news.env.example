# 部署前将交付根目录 .env.example 复制为 .env 并填写现场配置，文件权限设为 600。
# .env 属主必须与下方 NEWS_RUN_UID、NEWS_RUN_GID 一致，保证容器可以只读加载。
# Compose 将 .env 只读挂载到容器，现场配置不会进入镜像。
# 构建脚本填入真实版本和校验值，禁止只改文件名或标签冒充升级。
NEWS_VERSION=__BUILD_VERSION__
NEWS_ARTIFACT_SHA256=__ARTIFACT_SHA256__
NEWS_SOURCE_SHA256=__SOURCE_SHA256__

# 按现场数据库连接填写；host 网络可访问宿主机网络中的实际数据库地址。
NEWS_DB_HOST=__DB_HOST__
NEWS_DB_PORT=__DB_PORT__
NEWS_DB_USER=__DB_USER__
NEWS_DB_PASSWORD='__DB_PASSWORD__'
NEWS_DB_NAME=__ARCHIVE_DB_NAME__

# 容器归档目录必须与电子档案后台识别的文件路径一致；共享挂载在 Compose 中配置。
NEWS_HOST_DATA_DIR=__HOST_ARCHIVE_DIRECTORY__
NEWS_DATA_DIR=__CONTAINER_ARCHIVE_DIRECTORY__
NEWS_STATE_DIR=/var/lib/news/state
NEWS_SITE_ID=smzy
# 更改运行编号时，须同步核对归档目录和持久状态卷的属主与写入权限。
NEWS_RUN_UID=10001
NEWS_RUN_GID=10001

# HTTP 服务只接受采集请求，host 网络直接监听现场实际服务端口。
# 监听地址可按现场要求填写指定本机地址或所有接口地址。
NEWS_HTTP_HOST=__HTTP_LISTEN_ADDRESS__
NEWS_HTTP_PORT=__HTTP_PORT__
# 与电子档案定时任务参数中的 token 一致；留空时不启用请求鉴权。
NEWS_API_TOKEN=''

# 采集及文件生成参数；已经成功入库的文章按原文 URL 跳过。
NEWS_PDF_ENABLED=true
NEWS_VERIFY_TLS=true
NEWS_REQUEST_INTERVAL=1
